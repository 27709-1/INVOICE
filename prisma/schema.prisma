generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
enum Status { ACTIVE ARCHIVED DRAFT SENT PARTIALLY_PAID PAID OVERDUE CANCELLED VOIDED PENDING FAILED DELIVERED READ }
enum MovementType { PURCHASE SALE SALES_RETURN PURCHASE_RETURN STOCK_ADJUSTMENT DAMAGED EXPIRED MANUAL_ADDITION MANUAL_DEDUCTION CANCEL_REVERSAL }
enum PaymentType { CUSTOMER SUPPLIER EXPENSE RENT }
model User { id String @id @default(cuid()) email String @unique name String passwordHash String roleId String? role Role? @relation(fields:[roleId],references:[id]) auditLogs AuditLog[] createdAt DateTime @default(now()) }
model Role { id String @id @default(cuid()) name String @unique permissions Permission[] users User[] }
model Permission { id String @id @default(cuid()) key String @unique roles Role[] }
model Company { id String @id @default(cuid()) companyName String legalName String? logoUrl String? address1 String? address2 String? city String? state String? country String? postalCode String? phone String? email String? website String? gstVatNumber String? taxRegistrationNumber String? registrationNumber String? currency String @default("₹") financialYear String? invoicePrefix String @default("INV") invoiceStartingNumber Int @default(1) defaultTax Float @default(0) defaultDiscount Float @default(0) paymentTerms String? bankName String? bankAccountNumber String? ifscSwift String? bankBranch String? upiInfo String? signatoryName String? signatureUrl String? invoiceFooter String? terms String? updatedAt DateTime @updatedAt }
model Customer { id String @id @default(cuid()) name String companyName String? contactPerson String? phone String? whatsapp String? email String? billingAddress String? shippingAddress String? city String? state String? country String? postalCode String? taxNumber String? creditLimit Float @default(0) paymentTerms String? openingBalance Float @default(0) notes String? status Status @default(ACTIVE) invoices Invoice[] payments Payment[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Supplier { id String @id @default(cuid()) name String companyName String? contactPerson String? phone String? email String? address String? city String? state String? country String? taxNumber String? paymentTerms String? creditLimit Float @default(0) openingBalance Float @default(0) notes String? status Status @default(ACTIVE) products Product[] purchases Purchase[] payments Payment[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Category { id String @id @default(cuid()) name String @unique kind String @default("PRODUCT") active Boolean @default(true) products Product[] expenses Expense[] }
model Unit { id String @id @default(cuid()) name String @unique products Product[] }
model Tax { id String @id @default(cuid()) name String rate Float type String inclusive Boolean @default(false) description String? active Boolean @default(true) }
model Product { id String @id @default(cuid()) name String sku String @unique barcode String? categoryId String? category Category? @relation(fields:[categoryId],references:[id]) brand String? description String? unitId String? unit Unit? @relation(fields:[unitId],references:[id]) supplierId String? supplier Supplier? @relation(fields:[supplierId],references:[id]) costPrice Float sellingPrice Float defaultDiscount Float @default(0) taxRate Float @default(0) openingStock Float @default(0) currentStock Float @default(0) minimumStock Float @default(0) maximumStock Float @default(0) reorderLevel Float @default(0) active Boolean @default(true) items InvoiceItem[] purchaseItems PurchaseItem[] stockMovements StockMovement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Invoice { id String @id @default(cuid()) number String @unique invoiceDate DateTime supplyDate DateTime? dueDate DateTime? customerId String customer Customer @relation(fields:[customerId],references:[id]) customerSnapshot Json items InvoiceItem[] grossAmount Float @default(0) discountAmount Float @default(0) taxAmount Float @default(0) shipping Float @default(0) otherCharges Float @default(0) roundOff Float @default(0) grandTotal Float @default(0) amountPaid Float @default(0) balanceDue Float @default(0) cogs Float @default(0) profit Float @default(0) status Status @default(DRAFT) whatsappStatus Status? notes String? terms String? payments Payment[] communications CommunicationLog[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model InvoiceItem { id String @id @default(cuid()) invoiceId String invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade) productId String product Product @relation(fields:[productId],references:[id]) productName String sku String quantity Float unit String? costPrice Float sellingPrice Float discount Float @default(0) discountType String @default("AMOUNT") taxRate Float @default(0) taxAmount Float @default(0) subtotal Float finalAmount Float }
model Purchase { id String @id @default(cuid()) number String @unique supplierId String supplier Supplier @relation(fields:[supplierId],references:[id]) supplyDate DateTime? entryDate DateTime items PurchaseItem[] shipping Float @default(0) otherCharges Float @default(0) taxAmount Float @default(0) grandTotal Float @default(0) amountPaid Float @default(0) amountDue Float @default(0) status Status @default(SENT) notes String? payments Payment[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PurchaseItem { id String @id @default(cuid()) purchaseId String purchase Purchase @relation(fields:[purchaseId],references:[id],onDelete:Cascade) productId String product Product @relation(fields:[productId],references:[id]) productName String sku String quantity Float unit String? unitCost Float discount Float @default(0) taxRate Float @default(0) taxAmount Float @default(0) total Float }
model Payment { id String @id @default(cuid()) type PaymentType date DateTime customerId String? customer Customer? @relation(fields:[customerId],references:[id]) supplierId String? supplier Supplier? @relation(fields:[supplierId],references:[id]) invoiceId String? invoice Invoice? @relation(fields:[invoiceId],references:[id]) purchaseId String? purchase Purchase? @relation(fields:[purchaseId],references:[id]) amount Float method String reference String? notes String? reversed Boolean @default(false) createdAt DateTime @default(now()) }
model Expense { id String @id @default(cuid()) date DateTime categoryId String? category Category? @relation(fields:[categoryId],references:[id]) description String amount Float tax Float @default(0) method String vendor String? reference String? notes String? archived Boolean @default(false) rent RentExpense? createdAt DateTime @default(now()) }
model RentExpense { id String @id @default(cuid()) expenseId String @unique expense Expense @relation(fields:[expenseId],references:[id]) propertyName String landlord String? monthlyRent Float startDate DateTime endDate DateTime? dueDate DateTime? amountPaid Float @default(0) amountDue Float @default(0) paymentStatus Status @default(PENDING) notes String? }
model StockMovement { id String @id @default(cuid()) date DateTime @default(now()) productId String product Product @relation(fields:[productId],references:[id]) type MovementType quantity Float previousStock Float newStock Float reference String? userId String? notes String? }
model InvoiceTemplate { id String @id @default(cuid()) name String @default("Default") labels Json? colors Json? fonts Json? footer String? terms String? signatureUrl String? paymentInfo String? taxLabels Json? layout Json? active Boolean @default(true) }
model CommunicationLog { id String @id @default(cuid()) invoiceId String invoice Invoice @relation(fields:[invoiceId],references:[id]) customerId String whatsappNumber String date DateTime @default(now()) message String pdfFilename String sentBy String? status Status @default(PENDING) providerResponse Json? }
model AuditLog { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId],references:[id]) action String entity String entityId String? previousData Json? newData Json? createdAt DateTime @default(now()) }
